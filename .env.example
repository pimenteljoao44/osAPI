# =============================================================================
# Contrato de configuracao do osAPI — copie para .env (ou exporte no ambiente)
# e preencha. Em DEV nada disso e obrigatorio: ha defaults locais funcionais.
# Em PROD todas as variaveis abaixo sao OBRIGATORIAS (a aplicacao nao sobe sem).
# =============================================================================

# Perfil ativo: dev (default) | prod
SPRING_PROFILES_ACTIVE=dev

# Porta HTTP da API
SERVER_PORT=8080

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/marmoraria
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Segredo de assinatura dos tokens JWT (use um valor longo e aleatorio).
# Gere um com: openssl rand -base64 48
JWT_SECRET=

# Origens autorizadas a consumir a API (separadas por virgula).
# Em dev o default e http://localhost:4200; em prod e OBRIGATORIO.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# SMTP para envio de e-mail (recuperacao de senha)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
